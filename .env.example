# =============================================================================
# Bylaw — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- SERV / OpenServ Reasoning API ---

# Your OpenServ API key (required for live model calls)
SERV_API_KEY=your-serv-api-key-here

# OpenServ inference base URL (default shown; override if needed)
SERV_BASE_URL=https://inference-api.openserv.ai/v1

# Model name to use — run scripts/serv_smoke.py to discover available names
# See docs/OPEN_QUESTIONS.md OQ-5
SERV_MODEL=serv-model-placeholder

# --- Data mode ---

# live        : only IXS (live) + curated; fails loudly if unavailable
# mixed       : IXS vault + simulated peers (default)
# simulated   : all simulated; no network required (used for tests and demos)
DATA_MODE=simulated

# --- Offline demo mode ---

# Set to 0 to use the real SERV API. Default is 1 (stub) so tests and
# development work without an API key. A banner is shown in the UI when active.
OFFLINE_DEMO=1

# Maximum total SERV API calls allowed within a single Run (parse + proposals).
# Protects against credit runaway. Default 10 is generous for 3-attempt loops.
SERV_MAX_CALLS_PER_RUN=10

# --- IXS adapter (required for DATA_MODE=live or mixed) ---

# MCP endpoint for the IXS agent skills (see docs/OPEN_QUESTIONS.md OQ-2)
IXS_MCP_URL=

# IXS REST API base URL (see docs/OPEN_QUESTIONS.md OQ-2)
IXS_API_BASE_URL=

# IXS vault id to load (see docs/OPEN_QUESTIONS.md OQ-1 and OQ-2)
IXS_VAULT_ID=

# RPC URL for on-chain reads (must match the vault's chain)
IXS_RPC_URL=

# --- Host port ---

# Port exposed on the Docker host. Change when 8000 is busy (e.g. BYLAW_PORT=8080).
# The container always listens on 8000 internally; only the host side changes.
BYLAW_PORT=8000

# --- Logging ---

# Python log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
