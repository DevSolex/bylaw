# =============================================================================
# Bylaw — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- SERV / OpenServ Reasoning API ---

# Your OpenServ API key (required when OFFLINE_DEMO=0)
SERV_API_KEY=your-serv-api-key-here

# OpenServ inference base URL
SERV_BASE_URL=https://inference-api.openserv.ai/v1

# Model name — run scripts/serv_smoke.py to discover available names
SERV_MODEL=serv-model-placeholder

# Maximum SERV calls per Run (parse + proposals). Default 10 is generous.
SERV_MAX_CALLS_PER_RUN=10

# --- Data mode ---
#
# mixed     ← RECOMMENDED for judges
#   Shows the live IXS vault on BNB Smart Chain (paused, TVL, price-per-share
#   read from a public BSC RPC — no credentials needed) alongside three
#   simulated peer vaults. Falls back to the curated snapshot if the RPC is
#   unavailable, clearly labeled.
#
# simulated   All vaults are synthetic. No network calls. Good for offline demos.
# live        IXS live + curated peers only; fails loudly if RPC unavailable.
DATA_MODE=mixed

# --- SERV reasoning mode ---
#
# OFFLINE_DEMO=0  Use the real SERV API. Requires SERV_API_KEY. Recommended
#                 for judges to see live model reasoning.
# OFFLINE_DEMO=1  Stub all SERV calls deterministically. Works with any
#                 DATA_MODE — vault data (live IXS RPC) is fetched regardless.
#                 Tests always force this on via conftest.py.
OFFLINE_DEMO=0

# --- Capacity warning ---
# Warn in the UI when an allocation exceeds this fraction of a vault's TVL.
CAPACITY_WARN_SHARE=0.10

# --- IXS adapter (DATA_MODE=live or mixed) ---
# Leave blank to use the default public BSC RPC and confirmed contract address.
IXS_MCP_URL=
IXS_API_BASE_URL=
IXS_VAULT_ID=
IXS_RPC_URL=

# --- Host port ---
# Change when 8000 is busy on your machine.
BYLAW_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
